# Test that gdbserver correctly resets the report_thread_events flag
# when a new connection is established.
#
# In a normal GDB session the report_thread_events will only be
# switched on (via "QThreadEvents:1" packet) while GDB is waiting for
# some command to complete, after which the flag is disabled again
# using a "QThreadEvents:0" packet.
#
# However, if GDB unexpectedly disconnects while this feature is
# turned on, then when a new GDB connects gdbserver should
# automatically reset this flag.  At one point this was not happening.
# This test exists to check for this case.
#
# Connect to gdbserver, manually send QThreadEvents:1 to latch the
# flag on, disconnect, then reconnect with the thread-events packet
# disabled.  If gdbserver fails to reset the flag, it will send
# unsolicited T05create:; stop-reply packets for thread creation
# events.  Detect this using 'set remote debug on'.

require {!is_remote target} {!is_remote host}

load_lib gdbserver-support.exp

standard_testfile

require allow_gdbserver_tests

if { [build_executable "build executable" $testfile $srcfile \
	  {debug pthreads}] == -1 } {
    return
}

proc reconnection_and_thread_events {} {
    global GDBFLAGS gdbserver_reconnect_p use_gdb_stub

    save_vars { GDBFLAGS } {
	# If possible set the sysroot to avoid copying files.
	if { ![is_remote host] } {
	    set GDBFLAGS "$GDBFLAGS -ex \"set sysroot\""
	}
	clean_restart $::testfile

	# Make sure we're disconnected, in case we're testing with an
	# extended-remote board, therefore already connected.
	gdb_test "disconnect" ".*"
    }

    save_vars { gdbserver_reconnect_p use_gdb_stub } {
	# Setting this flag prevents gdbserver being started with the
	# --once option; this is required so that we can reconnect.
	set gdbserver_reconnect_p 1

	# This test always starts gdbserver in --multi mode, so clear
	# the use_gdb_stub global to allow gdb_start_cmd to work.
	set use_gdb_stub 0

	set res [gdbserver_start "--multi" "$::binfile"]
	set gdbserver_protocol "extended-remote"
	set gdbserver_gdbport [lindex $res 1]

	with_test_prefix "first connection" {
	    gdb_target_cmd $gdbserver_protocol $gdbserver_gdbport

	    # Start a new inferior.
	    if { [gdb_start_cmd] < 0 } {
		fail "start command"
		return
	    }

	    # gdb_start_cmd doesn't consume the prompt.  Collect it now.
	    gdb_test "" "" "wait for prompt after start"

	    gdb_breakpoint "breakpt_before_thread"
	    gdb_continue_to_breakpoint "before thread creation"

	    # Directly send QThreadEvents:1 to latch the flag on in
	    # gdbserver.  This is equivalent to what GDB does during resume
	    # when thread events are needed, but avoids depending on infrun
	    # internals that may also send QThreadEvents:0 before we can
	    # disconnect.
	    #
	    # The point here is to emulate an abnormal disconnection; the
	    # flag is turned on, but never turned off.
	    gdb_test "maintenance packet QThreadEvents:1" \
		"received: .*OK.*" \
		"send QThreadEvents:1"

	    gdb_test "disconnect" ".*"
	}

	with_test_prefix "second connection" {
	    # Disable both thread-events and thread-options packets so
	    # GDB will not send either on the new connection.
	    gdb_test "set remote thread-events-packet off" ".*"
	    gdb_test "set remote thread-options-packet off" ".*"

	    # Reconnect.  At this point there is already an inferior
	    # running, we can just pick up the debug session.
	    gdb_target_cmd $gdbserver_protocol $gdbserver_gdbport

	    gdb_breakpoint "breakpt_after_thread"

	    # Continue past the thread creation with debug remote enabled.
	    # If gdbserver failed to reset the report_thread_events flag,
	    # the thread creation will generate a T05create:; stop-reply
	    # packet.
	    gdb_test_no_output "set debug remote on"

	    # Continue.  Process the output line by line to avoid buffering
	    # excessive output.  Look for a 'T' packet mentioning the
	    # 'create' stop reason, this should only happen when the
	    # thread-events-packet is on.
	    set saw_create false
	    gdb_test_multiple "continue" \
		"continue without thread-create events" -lbl {
		    -re "\r\n\[^\r\n\]+Packet received: T\[^\r\n\]+create:\[^\r\n\]+(?=\r\n)" {
			set saw_create true
			exp_continue
		    }
		    -re "\r\n$::gdb_prompt $" {
			gdb_assert { !$saw_create } $gdb_test_name
		    }
		}

	    gdb_test_no_output -nopass "set debug remote off"
	}
    }
}

reconnection_and_thread_events
