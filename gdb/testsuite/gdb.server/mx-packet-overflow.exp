# Test that the 'm' and 'x' packets protect against buffer overflow,
# and that the 'X' packet rejects packets where the declared length
# doesn't match the amount of data actually sent.

load_lib gdbserver-support.exp

require allow_gdbserver_tests

standard_testfile

save_vars { GDBFLAGS } {
    # If GDB and GDBserver are both running locally, set the sysroot to avoid
    # reading files via the remote protocol (the `is_remote target` check is
    # already done above).
    if { ![is_remote host] } {
	set GDBFLAGS "$GDBFLAGS -ex \"set sysroot\""
    }
    if {[prepare_for_testing "failed to prepare" $testfile $srcfile]} {
	return
    }
}

# Make sure we're disconnected, in case we're testing with an
# extended-remote board, therefore already connected.
gdb_test "disconnect" ".*"

# Start gdbserver and connect.
set res [gdbserver_spawn ""]
set gdbserver_protocol [lindex $res 0]
set gdbserver_gdbport [lindex $res 1]
set res [gdb_target_cmd $gdbserver_protocol $gdbserver_gdbport]
if {![gdb_assert {$res == 0} "connect"]} {
    return
}

# Get into position for the test.
gdb_breakpoint [gdb_get_line_number "/* Break here.  */"]
gdb_continue_to_breakpoint "test position"

# The address of 'buffer' within the inferior, without the leading '0x'.
set buffer_addr [get_hexadecimal_valueof buffer 0x0 "get buffer address"]
set buffer_addr [string range $buffer_addr 2 end]

# The address of 'buffer2' within the inferior, without the leading '0x'.
set buffer2_addr [get_hexadecimal_valueof buffer2 0x0 "get buffer2 address"]
set buffer2_addr [string range $buffer2_addr 2 end]

# The size of buffer.  Leave this as hex with 0x prefix for now.
set buffer_len [get_hexadecimal_valueof buffer_length 0x0 "get buffer length"]

# Send PACKET, a full 'm' or 'x' packet, to the server using 'maint
# packet ...'.  EXPECTED is one of 'hex', 'binary', or 'error', and
# indicates the type of reply that gdbserver should send.
#
#   'hex' -- the result should be a hex encoded data packet, as
#            returned by a successful 'm' packet.
#
#   'binary' -- the result should be a binary encoded data packet, as
#               returned by a successful 'x' packet.
#
#   'error' -- the result should be an error packet, the 'm' or 'x'
#              packet failed.
#
# TESTNAME is used as the name for this test.
proc send_mx_packet { packet expected testname } {
    set result ""
    set drain_buffer false

    # Send the initial packet.  Detect full error reply here, or the
    # start of a hex or binary encoded result.  Do not parse the GDB
    # prompt pattern here.
    gdb_test_multiple "maint packet ${packet}" $testname {
	-re "\r\nreceived: \"E01\"" {
	    set result "error"
	}

	-re "\r\nreceived: \"b\[^\r\n\]*" {
	    set drain_buffer true
	    set result "binary"
	}

	-re "\r\nreceived: \"00\[^\r\n\]*" {
	    set drain_buffer true
	    set result "hex"
	}
    }

    # If the previous gdb_test_multiple found the start of a data
    # packet then consume the input now.  This avoids having to read
    # the entire result into the expect buffer; there could be a lot
    # of output.  Again, we don't parse the GDB prompt here.
    if { $drain_buffer } {
	gdb_test_multiple "" "" {
	    -re "^\[^\r\n\]+" {
		exp_continue
	    }

	    -re "^(?=\r\n)" {
	    }
	}
    }

    # Finally, consume the GDB prompt.  Check that the RESULT matches
    # EXPECTED.
    gdb_test_multiple "" "" {
	-re "\r\n$::gdb_prompt $" {
	    gdb_assert { $result eq $expected } $testname
	}
    }

    return $result
}

# Send 'm' and 'x' packets to gdbserver with various requested lengths, check
# that gdbserver handles the packets as we expect, rejecting those that are too
# long.  Use globals BUFFER_ADDR and BUFFER_LEN for testing these packets.
proc run_mx_packet_tests {} {
    # The size of the buffer allocated within gdbserver.  See PBUFSIZ in
    # gdbserver/server.h.
    set pbufsiz 0x20020

    # If we ask GDB to read the entire buffer from the inferior, GDB will
    # perform many 4-byte reads.  This does a good job of protecting
    # gdbserver from buffer overflows, but it hides the bug that this test
    # is trying to expose.
    #
    # Manually send 'm' or 'x' packets so we can control the contents.
    #
    # Try different sizes, BUFFER_LEN is huge, far bigger than the
    # allocated buffer.  PBUFSIZ is the exact size of the buffer within
    # gdbserver used to build the result packet.  Test various sizes based
    # on PBUFSIZ as well as the full BUFFER_LEN.
    #
    # This test works best when gdbserver is built with the address
    # sanitizers, as out-of-bounds writes will trigger the sanitizer.
    set test_lengths [list $pbufsiz \
			  [expr { $pbufsiz + 1 }] \
			  [expr { $pbufsiz / 2 }] \
			  [expr { $pbufsiz / 2 + 1 }] \
			  $::buffer_len]
    foreach_with_prefix req_len $test_lengths {
	# Make LEN be REQ_LEN in hex, without the '0x' prefix.
	set len [string range [format "0x%x" $req_len] 2 end]

	# Set M_RESULT and X_RESULT to 'hex', 'binary', or 'error'
	# depending on what the packet result should be.  See
	# send_mx_packet for more details.
	set m_result "hex"
	set x_result "binary"

	if { $req_len > $pbufsiz } {
	    set x_result "error"
	}

	if { $req_len > $pbufsiz / 2 } {
	    set m_result "error"
	}

	# Send the packets.
	send_mx_packet "m${::buffer_addr},${len}" $m_result \
	    "test 'm' packet, expect $m_result"
	send_mx_packet "x${::buffer_addr},${len}" $x_result \
	    "test 'x' packet, expect $x_result"
    }
}

# Send 'X' packets to gdbserver with various different declared
# lengths and payloads, check that gdbserver handles the packets as we
# expect; rejecting those where the declared length doesn't match the
# amount of data actually sent.
proc run_X_packet_tests {} {

    # The 'X' packet tests write into the inferior.  Use BUFFER2 as the
    # write target.  This buffer has a known size of 16 bytes.
    set x_addr $::buffer2_addr

    # Send a couple of valid 'X' packets, and, for each one, read the
    # memory back to check that the correct bytes were written.
    gdb_test "maint packet X${x_addr},4:abcd" "\r\nreceived: \"OK\"" \
	"test 'X' packet, 4 declared, 4 sent"
    gdb_test "maint packet m${x_addr},4" "\r\nreceived: \"61626364\"" \
	"check 'X' packet, 4 declared, wrote correct bytes"

    gdb_test "maint packet X${x_addr},2:ef" "\r\nreceived: \"OK\"" \
	"test 'X' packet, 2 declared, 2 sent"
    gdb_test "maint packet m${x_addr},2" "\r\nreceived: \"6566\"" \
	"check 'X' packet, 2 declared, wrote correct bytes"

    # A packet where the data contains escape sequences; the escaped
    # sequence resolves to two bytes of data, which matches the declared
    # length, so this should be accepted.
    gdb_test "maint packet X${x_addr},2:\}G\}H" "\r\nreceived: \"OK\"" \
	"test 'X' packet, 2 declared, data expands to 2 bytes"
    gdb_test "maint packet m${x_addr},2" "\r\nreceived: \"6768\"" \
	"check 'X' packet, 2 declared, escaped, wrote correct bytes"

    # Claim to be sending more data than is actually sent.
    gdb_test "maint packet X${x_addr},8:ab" "\r\nreceived: \"E01\"" \
	"test 'X' packet, 8 declared, 2 sent"

    # A packet where the declared length is more than the amount of
    # data sent once the escape sequences have been expanded.
    gdb_test "maint packet X${x_addr},2:\}A" "\r\nreceived: \"E01\"" \
	"test 'X' packet, 2 declared, data expands to 1 byte"

    # Claim a huge payload is being sent.  Without some sanity checks
    # gdbserver would try to allocate a buffer to hold all the
    # declared data, and run out of memory.
    gdb_test "maint packet X${x_addr},ffffffff:a" "\r\nreceived: \"E01\"" \
	"test 'X' packet, huge declared length"
}

# Run the m/x packet tests, then the 'X' packet tests.
run_mx_packet_tests
run_X_packet_tests

# Test within a qSymbol loop.  Send a 'qSymbol::' packet to gdbserver.
# It should either reply with 'qSymbol:<name>' or 'OK'.  If we get OK
# then gdbserver doesn't want to know any symbols from GDB, so we
# cannot get access to its inner packet processing loop.  If we get
# back a symbol request though, then we can send some m/x/X packets to
# test the inner packet processing loop.
set first_symbol_requested ""
gdb_test_multiple "maint packet qSymbol::" "start qSymbol loop" {
    -re -wrap "\r\nreceived: \"OK\"" {
	unsupported "$gdb_test_name (no symbols requested)"
    }

    -re -wrap "\r\nreceived: \"qSymbol:(\[^\"\]+)\"" {
	set first_symbol_requested $expect_out(1,string)
	pass $gdb_test_name
    }
}

# We got a symbol request from gdbserver; run the m/x and 'X' packet
# tests, then complete the qSymbol loop.
if { $first_symbol_requested ne "" } {
    with_test_prefix "in qSymbol loop" {
	run_mx_packet_tests
	run_X_packet_tests
    }

    set symbol_name $first_symbol_requested
    gdb_test_multiple "maint packet qSymbol::$symbol_name" \
	"qSymbol loop completed" {
	    -re -wrap "\r\nreceived: \"OK\"" {
		pass $gdb_test_name
	    }

	    -re -wrap "\r\nreceived: \"qSymbol:(\[^\"\]+)\"" {
		set symbol_name $expect_out(1,string)
		send_gdb "maint packet qSymbol::$symbol_name\n"
		exp_continue
	    }
	}
}
