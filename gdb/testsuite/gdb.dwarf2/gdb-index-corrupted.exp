# Test that GDB handles a corrupt .gdb_index gracefully.  This test
# checks a number of different scenarios, check the 'gdb_index' calls
# within the 'run_test' proc for details.

load_lib dwarf.exp

require dwarf2_support

# This test installs its own hand-crafted .gdb_index into the
# executable.  The 'readnow' board forces GDB to ignore the index and
# read the full debug info, making this test irrelevant.
require !readnow

standard_testfile

if {[prepare_for_testing "failed to prepare" "${testfile}" \
	 [list ${srcfile}] {debug ldflags=-nostartfiles}]} {
    return
}

set index [have_index $binfile]
if { ![string eq $index ""] } {
    unsupported "cache created at compile time"
    return
}

set func_info_vars \
    [get_func_info _start [list debug ldflags=-nostartfiles]]

# TESTNAME is a string that is used to identify the test to run.  This
# string is used to control how the gdb_index is created, and then
# what checks are performed on the executable after loading it.
proc run_test { testname } {
    set asm_file [standard_output_file ${testname}.S]
    Dwarf::assemble {
	filename $asm_file
	add_dummy_cus 0
    } {
	upvar testname testname
	global func_info_vars
	foreach var $func_info_vars {
	    global $var
	}

	cu { label cu_label } {
	    compile_unit {
		DW_AT_language @DW_LANG_C_plus_plus
	    } {
		subprogram {
		    DW_AT_name _start
		    DW_AT_low_pc $_start_start DW_FORM_addr
		    DW_AT_high_pc $_start_end DW_FORM_addr
		    DW_AT_external 1 DW_FORM_flag
		}
	    }
	}

	aranges {} cu_label {
	    arange {} $_start_start $_start_len
	}

	if { $testname eq "empty-component" } {
	    # GDB tries to split entries within the index based on
	    # '::' by default.  Create an index entry with an empty
	    # component and ensure that this doesn't trigger undefined
	    # behaviour in GDB.
	    gdb_index {} {
		cu cu_label
		name "::method" {{cu_label function global}}
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "main-name-offset-1" } {
	    # Add main function details to a basic index, but encode
	    # an out of range name offset using the special string
	    # 'end'.  Ensure that GDB doesn't crash and instead just
	    # ignores the main function details.
	    #
	    # Using 'end' here means that the constant pool index used
	    # for the main entry will point at the first byte after
	    # the constant pool.  This is the off-by-one boundary
	    # case.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		main DW_LANG_C99 end
	    }
	} elseif { $testname eq "main-name-offset-2" } {
	    # Add main function details to a basic index, but encode
	    # an out of range name offset.  Ensure that GDB doesn't
	    # crash and instead just ignores the main function details.
	    #
	    # This is very similar to the 'main-name-offset-1' test,
	    # but here the name offset is huge, far past the end of
	    # the constant pool.  This is far more likely to cause GDB
	    # to crash.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		main DW_LANG_C99 0xffffff00
	    }
	} elseif { $testname eq "main-language" } {
	    # Add main function details to a basic index, but encode
	    # an invalid language number.  Ensure that GDB ignores the
	    # main function details.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		main 0xfffff0 _start
	    }
	} elseif { $testname eq "no-null" } {
	    # Create a .gdb_index without a null character at the end
	    # of the string table.  This is invalid and GDB should just
	    # ignore this .gdb_index.
	    gdb_index {
		no_null true
	    } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "skip-constant-pool" } {
	    # Create a .gdb_index with a non-empty symbol table but an
	    # empty constant pool.  GDB should ignore this .gdb_index.
	    gdb_index {
		skip_index_part { constant_pool }
	    } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "long-cu-vector" } {
	    # Create a .gdb_index containing a CU vector in the
	    # constant pool where the vector length is invalid.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {99999 {cu_label function global}}
	    }
	} elseif { $testname eq "name-offset-1" } {
	    # Add a symbol to the index whose name offset in the symbol
	    # table is out of range.  The slot still has a valid CU
	    # vector, so GDB won't treat it as an empty slot and will
	    # try to read the name.  Ensure GDB doesn't crash and
	    # instead just ignores this one symbol.
	    #
	    # The 'end' offset is exactly the size of the constant pool,
	    # that is, it points at the first byte after the pool.  This
	    # is the off-by-one boundary case.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}} end
	    }
	} elseif { $testname eq "name-offset-2" } {
	    # Just like 'name-offset-1', but here the name offset is
	    # huge, far past the end of the constant pool.  This is far
	    # more likely to cause GDB to crash.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}} 0xffffff00
	    }
	} elseif { $testname eq "cu-vector-offset-1" } {
	    # Add a symbol whose CU vector offset in the symbol table is out
	    # of range.  The slot has a valid name offset, so GDB won't
	    # treat it as an empty slot and will try to read the CU vector.
	    # Ensure GDB doesn't crash and instead just ignores this one
	    # symbol.
	    #
	    # The 'end' offset is exactly the size of the constant pool,
	    # that is, it points at the first byte after the pool.  This is
	    # the off-by-one boundary case.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}} "" end
	    }
	} elseif { $testname eq "cu-vector-offset-2" } {
	    # Just like 'cu-vector-offset-1', but here the CU vector offset
	    # is huge, far past the end of the constant pool.  This is far
	    # more likely to cause GDB to crash.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}} "" 0xffffff00
	    }
	} elseif { $testname eq "cu-vector-offset-3" } {
	    # Like cu-vector-offset-1/-2, but aim the CU vector offset at
	    # the last byte of the constant pool.  That byte offset is in
	    # range, but there is no room there for the 4-byte CU vector
	    # length word that GDB reads.  This ensures that GDB is
	    # correctly validating the entire length of its reads.
	    #
	    # Work out the constant pool size from its contents.  There are
	    # two symbols that need adding to the constant pool, '_start'
	    # and 'foo'.  For each symbol we have a CU vector (a 4-byte
	    # count and a 4-byte offset), then we have both symbol strings
	    # plus their null terminating character.
	    set pool_size \
		[expr {2 * (4 + 4) + [string length "_start"] + 1 \
			   + [string length "foo"] + 1}]
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}} "" [expr {$pool_size - 1}]
	    }
	} elseif { $testname eq "bad-cu-length" } {
	    # Create an otherwise valid index, but record a bogus length
	    # for the CU in the index's CU list; one that doesn't match the
	    # actual length of the CU in .debug_info.  GDB should handle
	    # this gracefully rather than crashing when it later comes to
	    # expand the CU.
	    gdb_index {} {
		cu cu_label 0x1f
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "addr-truncated-1" } {
	    # Create an address table with a truncated entry (missing the
	    # high address and CU index).  The address table size is not a
	    # multiple of 20 bytes (the entry size), so GDB should reject
	    # this .gdb_index.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		bad_addr $_start_start
	    }
	} elseif { $testname eq "addr-truncated-2" } {
	    # Like addr-truncated-1 above, but with both low and high
	    # addresses (missing only the CU index now).  This creates a
	    # 16-byte entry instead of 20.  Again, GDB should reject this
	    # .gdb_index.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		bad_addr $_start_start $_start_end
	    }
	} elseif { $testname eq "addr-valid" } {
	    # Create a valid address table, just to ensure that the address
	    # table creation mechanism within the gdb_index proc works
	    # correctly.  GDB should accept this .gdb_index, and later on we
	    # check that we see the expected address map entries.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		addr $_start_start $_start_end cu_label
	    }
	} elseif { $testname eq "addr-swapped" } {
	    # Create an address table with the low and high addresses the
	    # wrong way around.  GDB should reject this .gdb_index and give
	    # an appropriate warning message.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		addr $_start_end $_start_start cu_label
	    }
	} elseif { $testname eq "addr-overlap" } {
	    # Create an address table with multiple address ranges.  Two of
	    # the address ranges overlap.  GDB should reject this index.
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}}
		addr $_start_start "$_start_end - 2" cu_label
		addr "$_start_end - 4" $_start_end cu_label
	    }
	} elseif { $testname eq "header-cu-list-invalid" } {
	    # Create an index with an out-of-bounds CU list offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {cu_list 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "header-tu-list-invalid" } {
	    # Create an index with an out-of-bounds TU list offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {tu_list 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "header-address-table-invalid" } {
	    # Create an index with an out-of-bounds address table offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {address_table 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "header-symbol-table-invalid" } {
	    # Create an index with an out-of-bounds symbol table offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {symbol_table 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "header-shortcut-invalid" } {
	    # Create an index with an out-of-bounds shortcut table offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {shortcut 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "header-constant-pool-invalid" } {
	    # Create an index with an out-of-bounds constant pool offset.
	    # GDB should detect this and reject the index.
	    gdb_index { header_override {constant_pool 0xffffffff} } {
		cu cu_label
		name _start {{cu_label function global}}
	    }
	} elseif { $testname eq "valid-index" } {
	    # Generate a well-formed index that includes a valid main
	    # function (valid language, with the name pointing at the
	    # '_start' symbol).  This is a sanity check that index
	    # generation works, at one point this got broken and this
	    # wasn't spotted straight away as every index was broken
	    # in some subtle way.
	    #
	    # The C language is used, rather than C++, for the main
	    # function as for C++/Ada GDB only honours an IS_MAIN entry
	    # whose name is literally "main".
	    gdb_index {} {
		cu cu_label
		name _start {{cu_label function global}}
		name foo {{cu_label function global}}
		main DW_LANG_C99 _start
	    }
	} else {
	    perror "invalid testname '$testname' during .gdb_index creation"
	}
    }

    set testfile ${::testfile}-${testname}
    set binfile [standard_output_file $testfile]
    if {[build_executable "build executable" \
	     $testfile "$asm_file $::srcfile" \
	     [list ldflags=-nostartfiles]] == -1} {
	return
    }

    clean_restart

    gdb_test_no_output "maint set dwarf synchronous on"
    gdb_test_no_output "set complaints 100"

    # Loading the binary should not crash despite whatever weird
    # things are in the .gdb_index.
    gdb_load $binfile

    # If we're using the cc-with-gnu-debuglink board then the debug
    # information will have been moved to a separate file.
    if { [section_get $binfile ".gnu_debuglink"] eq "" } {
	set suffix ""
    } else {
	# If we are using a debuglink then assume the debug is moved
	# into a file with a .debug suffix.
	set suffix ".debug"
    }

    # Setup the expected results based on the testname.
    if { $testname eq "empty-component" } {
	set expect_gdb_index_ignored false
	set expect_start true
	set expect_method true
	set expect_main false
	set expect_foo false
	set expect_name_count 2
	set expect_addr_map {}
	set expect_warning_re ""
    } elseif { $testname eq "main-name-offset-1" \
		   || $testname eq "main-name-offset-2" \
		   || $testname eq "main-language" \
		   || $testname eq "long-cu-vector" \
		   || $testname eq "name-offset-1" \
		   || $testname eq "name-offset-2" \
		   || $testname eq "cu-vector-offset-1" \
		   || $testname eq "cu-vector-offset-2" \
		   || $testname eq "cu-vector-offset-3" \
		   || $testname eq "bad-cu-length" } {
	set expect_gdb_index_ignored false
	set expect_start true
	set expect_method false
	set expect_main false
	set expect_foo false
	set expect_name_count 1
	if { $testname eq "main-language" } {
	    set expect_warning_re "\r\nDuring symbol reading: \\.gdb_index shortcut table has invalid main language $::decimal\r\n"
	} elseif { $testname eq "main-name-offset-1" \
		       || $testname eq "main-name-offset-2" } {
	    set expect_warning_re "\r\nDuring symbol reading: \\.gdb_index shortcut table has invalid main name offset $::decimal\r\n"
	} elseif { $testname eq "name-offset-1" \
		       || $testname eq "name-offset-2" } {
	    set expect_warning_re "\r\nDuring symbol reading: \\.gdb_index entry $::decimal has bad name offset $::decimal \\\[in module \[^\r\n\]+\\\]\r\n"
	} elseif { $testname eq "cu-vector-offset-1" \
		       || $testname eq "cu-vector-offset-2" \
		       || $testname eq "cu-vector-offset-3" } {
	    set expect_warning_re "\r\nDuring symbol reading: \\.gdb_index entry $::decimal has bad CU vector offset $::decimal \\\[in module \[^\r\n\]+\\\]\r\n"
	} else {
	    set expect_warning_re ""
	}
	set expect_addr_map {}
    } elseif { $testname eq "header-cu-list-invalid" \
		   || $testname eq "header-tu-list-invalid" \
		   || $testname eq "header-address-table-invalid" \
		   || $testname eq "header-symbol-table-invalid" \
		   || $testname eq "header-shortcut-invalid" \
		   || $testname eq "header-constant-pool-invalid" } {
	# Each of these tests puts an out-of-range offset in one field of
	# the index header.  GDB should detect the invalid offset, emit a
	# warning, and reject the index.
	set expect_gdb_index_ignored true
	set expect_warning_re "\r\nwarning: skipping \\.gdb_index section in \[^\r\n\]*, an invalid offset \\($::hex\\) was found in the header\r\n"
    } elseif { $testname eq "addr-valid" } {
	set expect_start true
	set expect_method false
	set expect_main false
	set expect_foo false
	set expect_name_count 1
	set start [get_hexadecimal_valueof "$::_start_start" "*default*" \
		       "get address for start of _start"]
	set end [get_hexadecimal_valueof "$::_start_end" "*default*" \
		     "get address for end of _start"]
	set expect_addr_map \
	    [list [list [format "0x%x" $start] [format "0x%x" $end]]]
	set expect_gdb_index_ignored false
	set expect_warning_re ""
    } elseif { $testname eq "addr-truncated-1" \
		   || $testname eq "addr-truncated-2" \
		   || $testname eq "addr-swapped" \
		   || $testname eq "addr-overlap" } {
	set expect_gdb_index_ignored true
	if { $testname eq "addr-truncated-1" \
		 || $testname eq "addr-truncated-2" } {
	    set expect_warning_re "\r\nwarning: \\.gdb_index address table has invalid size \\($::decimal bytes\\), ignoring \\.gdb_index\r\n"
	} elseif { $testname eq "addr-swapped" } {
	    set expect_warning_re "\r\nwarning: \\.gdb_index address table has invalid range \\($::hex - $::hex\\), ignoring \\.gdb_index\r\n"
	} elseif { $testname eq "addr-overlap" } {
	    set expect_warning_re "\r\nwarning: \\.gdb_index address table has a range \\($::hex - $::hex\\) that overlaps with an earlier range, ignoring \\.gdb_index\r\n"
	} else {
	    perror "invalid testname '$testname' during index check"
	}
    } elseif { $testname eq "valid-index" } {
	# This is a well-formed index, so GDB should see _start and
	# should recognise it as the main function.
	set expect_gdb_index_ignored false
	set expect_start true
	set expect_method false
	set expect_main true
	set expect_foo true
	set expect_name_count 2
	set expect_addr_map {}
	set expect_warning_re ""
    } elseif { $testname eq "no-null"
	       || $testname eq "skip-constant-pool" } {
	set expect_gdb_index_ignored true
	if { $testname eq "no-null" } {
	    set expect_warning_re "\r\nwarning: skipping .gdb_index in \[^\r\n\]+, null byte at end of constant pool is missing\r\n"
	} else {
	    set expect_warning_re ""
	}

	# No need to set any of the other EXPECTED_* variables as they
	# will never be used.
    } else {
	perror "invalid testname '$testname' during index check"
    }

    # Check the expected warning was emitted while loading the
    # executable.  The GDB_FILE_CMD_MSG global was set by the call to
    # gdb_load above.
    if { $expect_warning_re ne "" } {
	gdb_assert { [regexp $expect_warning_re $::gdb_file_cmd_msg] } \
	    "index rejected with expected warning"
    } else {
	gdb_assert { ![regexp "\r\nDuring symbol reading: " \
			   $::gdb_file_cmd_msg] \
			 && ![regexp "\r\nwarning: " \
				  $::gdb_file_cmd_msg] } \
	    "index loaded without any warnings or complaints"
    }

    # Check if GDB used a .gdb_index section, or ignored it.
    set index [get_index_type [file tail $binfile]$suffix]
    if { $expect_gdb_index_ignored } {
	gdb_assert { [string equal $index "cooked"] } ".gdb_index ignored"

	# Ensure that an attempt to expand all symtabs doesn't crash GDB,
	# even when the index is corrupted as it is in this test.
	gdb_test_no_output "maint expand-symtabs" "expand all symtabs"

	return
    } else {
	gdb_assert { [string equal $index "gdb"] } ".gdb_index used"
    }

    # Take a look at the details of the loaded .gdb_index and check
    # that they match the expected results.
    set saw_start false
    set saw_method false
    set saw_foo false
    set saw_main ""
    set name_count 0
    set addr_map {}
    set addr_map_entry_start ""
    set in_address_maps false
    gdb_test_multiple "maint print objfiles" "" -lbl {
	-re "^\r\n\\s+name:\\s+(\[^\r\n\]+)(?=\r\n)" {
	    incr name_count
	    set name $expect_out(1,string)
	    if { $name eq "_start" } {
		set saw_start true
	    } elseif { $name eq "method" } {
		set saw_method true
	    } elseif { $name eq "foo" } {
		set saw_foo true
	    }
	    exp_continue
	}
	-re "^\r\n\\s+main: \\(\\(cooked_index_entry \\*\\) ($::decimal|$::hex)\\)\[^\r\n\]*(?=\r\n)" {
	    set offset $expect_out(1,string)
	    if { $offset eq "0" } {
		set saw_main false
	    } else {
		set saw_main true
	    }
	    exp_continue
	}
	-re "^\r\n\\s+address maps:(?=\r\n)" {
	    set in_address_maps true
	    exp_continue
	}
	-re "^\r\n\\s+\\\[($::hex)\\\] \\(\\(dwarf2_per_cu \\*\\) (0|$::hex)\\)(?=\r\n)" {
	    if { $in_address_maps } {
		set start [format "0x%x" $expect_out(1,string)]
		set obj $expect_out(2,string)

		# Finish any existing entry.
		if { $addr_map_entry_start ne "" } {
		    lappend addr_map [list $addr_map_entry_start $start]
		    set addr_map_entry_start ""
		}

		# Create the start of a new entry.
		if { $obj ne "0" } {
		    set addr_map_entry_start $start
		}
	    }
	    exp_continue
	}
	-re "^\r\n$::gdb_prompt $" {
	    gdb_assert { $saw_start == $expect_start \
			     && $saw_method == $expect_method \
			     && $saw_main == $expect_main \
			     && $name_count == $expect_name_count \
			     && $saw_foo == $expect_foo \
			     && $addr_map == $expect_addr_map } \
		$gdb_test_name
	}
    }

    # Ensure that an attempt to expand all symtabs doesn't crash GDB,
    # even when the index is corrupted as it is in this test.
    gdb_test_no_output "maint expand-symtabs" "expand all symtabs"
}

set tests { empty-component \
		main-name-offset-1 \
		main-name-offset-2 \
		main-language \
		no-null \
		skip-constant-pool \
		long-cu-vector \
		name-offset-1 \
		name-offset-2 \
		cu-vector-offset-1 \
		cu-vector-offset-2 \
		cu-vector-offset-3 \
		bad-cu-length \
		addr-truncated-1 \
		addr-truncated-2 \
		addr-swapped \
		addr-overlap \
		addr-valid \
		header-cu-list-invalid \
		header-tu-list-invalid \
		header-address-table-invalid \
		header-symbol-table-invalid \
		header-shortcut-invalid \
		header-constant-pool-invalid \
		valid-index }

foreach_with_prefix test $tests {
    run_test $test
}
